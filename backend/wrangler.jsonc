{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marai-api",
  "main": ".wrangler/marai-src/worker.py",
  "base_dir": ".wrangler/marai-src",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["python_workers"],
  "build": {
    "command": "node prepare-worker.mjs",
    "watch_dir": ["app", "worker.py", "prepare-worker.mjs"]
  },
  "python_modules": {
    "exclude": ["**/*.pyc", "**/__pycache__/**", "**/*.pyi"]
  },
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/dist-cloudflare",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/docs", "/docs/*", "/redoc", "/openapi.json"]
  },
"hyperdrive": [
  {
    "binding": "HYPERDRIVE",
    "id": "6cd38b9e9ac24af889dae1009d1b4d43"
  }
],
  "durable_objects": {
    "bindings": [
      { "name": "PASSWORD_KDF", "class_name": "PasswordKdf" }
    ]
  },
  "migrations": [
    { "tag": "password-kdf-v1", "new_sqlite_classes": ["PasswordKdf"] }
  ],
  "observability": { "enabled": false }
}
