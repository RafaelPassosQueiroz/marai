{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marai-api",
  "main": "worker.py",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_EXISTING_HYPERDRIVE_CONFIG_ID"
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://rafaelpassosqueiroz.github.io",
    "COOKIE_SECURE": "true"
  }
}
