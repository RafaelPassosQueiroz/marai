# Keep the existing .env in the project root. Never place keys in VITE_* variables.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: valid contact email for the MyMemory free daily allowance.
# Leave empty for anonymous translation; no key or payment is required.
MYMEMORY_EMAIL=
DATABASE_URL=postgresql+psycopg://marai:marai_local@127.0.0.1:5433/marai
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# edge: stable fixed voices for each language, without a third API key.
# gemini: Gemini speech, with automatic Edge fallback (voice can change on fallback).
TTS_PROVIDER=edge
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
SESSION_DAYS=14
GEMINI_COOLDOWN_SECONDS=300
MAX_AUDIO_SECONDS=120
MAX_AUDIO_BYTES=8388608
# Google sign-in requires its own OAuth client, independently of Gemini.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
